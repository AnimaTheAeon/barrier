package="Barrier"
version="@VERSION@"
os_min_ver="7.2.1-69057"
displayname="Barrier"
description="Runs your ExpressVPN (OpenVPN locations) on the NAS with a web page to connect and pick locations, and a kill switch. Lifestream lives inside it, so its traffic can only leave through the VPN. Updates itself."
install_dep_packages="ContainerManager>=20.10.23-1432"
maintainer="Barrier"
arch="x86_64 r1000 v1000 geminilake apollolake denverton broadwell broadwellnk broadwellnkv2 broadwellntbap purley epyc7002 avoton braswell bromolow cedarview grantley kvmx64"
dsmuidir="ui"
dsmappname="Barrier.Web"
thirdparty="yes"
ctl_stop="yes"
startable="yes"
silent_install="no"
silent_upgrade="yes"
silent_uninstall="yes"
beta="no"
